  "scripts": {
    "clean:folders": "find . \\( -name 'node_modules' -o -name '.next' \\) -exec rm -rf {} +",
    "clean:files": "find . \\( -name 'package-lock.json' -o -name 'pnpm-lock.yaml' -o -name '*.tsbuildinfo' \\) -exec rm -f {} +",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "prettier": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "eslint": "next lint"
  },
