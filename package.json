{
  "name": "project_booking-app",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/web run dev",
    "build": "pnpm --filter @workspace/web run build",
    "start": "pnpm --filter @workspace/web run start",
    "prettier": "pnpm --filter @workspace/web run prettier",
    "typecheck": "pnpm --filter @workspace/web run typecheck",
    "lint": "pnpm --filter @workspace/web run lint",
    "format:all": "pnpm run prettier && pnpm run typecheck && pnpm run lint && pnpm run build",
    "files:to-lf": "find . \\( -name 'node_modules' -o -name 'dist' \\) -prune -o -type f -exec dos2unix {} +",
    "clean:builds": "find . -name 'dist' -exec rm -rf {} +",
    "clean:folders": "find . -name 'node_modules' -exec rm -rf {} +",
    "clean:files": "find . \\( -name 'package-lock.json' -o -name 'yarn.lock' -o -name 'pnpm-lock.yaml' -o -name '*.tsbuildinfo' \\) -exec rm -f {} +",
    "clean:all": "pnpm run clean:builds && pnpm run clean:folders && pnpm run clean:files"
  }
}
